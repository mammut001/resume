{
  "name": "web-cv",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "typst:ensure": "node scripts/ensure-typst.cjs",
    "build": "npm run build:resume-pdf && npm run build:web",
    "build:web": "next build",
    "generate:resume-typst": "node scripts/generate-resume-typst.cjs",
    "build:resume-pdf": "npm run generate:resume-typst && node scripts/run-typst.cjs compile typst/resume.typ public/payton-pei-resume.pdf && node scripts/run-typst.cjs compile typst/resume.fr.typ public/payton-pei-resume-fr.pdf && node scripts/run-typst.cjs compile typst/resume.zh.typ public/payton-pei-resume-zh.pdf",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.0.2",
    "@vercel/analytics": "^1.1.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "cmdk": "^0.2.0",
    "geist": "^1.7.0",
    "lucide-react": "^0.300.0",
    "next": "^15.5.29",
    "next-themes": "^0.4.6",
    "react": "^18",
    "react-dom": "^18",
    "react-github-calendar": "^5.0.6",
    "tailwind-merge": "^2.2.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.8.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8",
    "prettier": "^3.1.1",
    "prettier-plugin-tailwindcss": "^0.5.9",
    "tailwindcss": "^3.4.0",
    "typescript": "^5"
  }
}
